    {
        "id": "fn_anomaly_alert",
        "type": "function",
        "z": "tab_smart_meter_ai",
        "name": "Process AI Status",
        "func": "var data = msg.payload;\n\n// 1. Status Banner HTML\nvar bannerHtml = '';\nif (data.is_anomaly) {\n    bannerHtml = '<div style=\"background-color:#d32f2f;color:white;padding:12px;border-radius:8px;font-weight:bold;text-align:center;font-size:16px;box-shadow:0 0 12px rgba(211,47,47,0.8);\">' +\n                 '🚨 ANOMALY DETECTED: ' + data.anomaly_type + '<br>' +\n                 '<span style=\"font-size:13px;font-weight:normal;\">' + data.description + '</span></div>';\n} else {\n    bannerHtml = '<div style=\"background-color:#2e7d32;color:white;padding:12px;border-radius:8px;font-weight:bold;text-align:center;font-size:16px;\">' +\n                 '✅ SYSTEM NORMAL - Consumption Baseline Stable</div>';\n}\n\nvar msgBanner = { payload: bannerHtml };\nvar msgType = { payload: data.anomaly_type };\nvar msgSeverity = { payload: data.severity };\nvar msgScore = { payload: 'AI Score: ' + data.anomaly_score };\n\n// Trigger Toast Notification on Anomaly\nvar msgToast = null;\nif (data.is_anomaly) {\n    msgToast = {\n        payload: data.anomaly_type + ' (' + data.severity + '): ' + data.description,\n        topic: '⚠️ Smart Meter Anomaly Alert'\n    };\n}\n\nreturn [msgBanner, msgType, msgSeverity, msgScore, msgToast];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 360,
        "wires": [
            ["template_status_banner"],
            ["text_anomaly_type"],
            ["text_severity"],
            ["text_ai_score"],
            ["toast_anomaly_alert"]
        ]
    },
