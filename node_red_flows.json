    {
        "id": "fn_recent_log",
        "type": "function",
        "z": "tab_smart_meter_ai",
        "name": "Maintain Incident History",
        "func": "var data = msg.payload;\n\n// Keep the last 6 anomaly incidents in context\nvar logs = context.get('logs') || [];\n\nif (data.is_anomaly) {\n    logs.unshift({\n        time: data.timestamp.split(' ')[1] || data.timestamp,\n        type: data.anomaly_type,\n        power: data.power_kw + ' kW',\n        volt: data.voltage + ' V',\n        severity: data.severity\n    });\n    if (logs.length > 6) {\n        logs.pop();\n    }\n    context.set('logs', logs);\n}\n\nvar html = '<table style=\"width:100%;border-collapse:collapse;font-size:12px;text-align:left;\">';\nhtml += '<tr style=\"border-bottom:1px solid #444;color:#0eb8c0;\"><th>Time</th><th>Anomaly Type</th><th>Power</th><th>Voltage</th><th>Severity</th></tr>';\n\nif (logs.length === 0) {\n    html += '<tr><td colspan=\"5\" style=\"padding:8px;text-align:center;color:#888;\">No anomalies detected yet. Monitoring active.</td></tr>';\n} else {\n    for (var i = 0; i < logs.length; i++) {\n        var color = logs[i].severity === 'CRITICAL' ? '#ff5252' : '#ffb142';\n        html += '<tr style=\"border-bottom:1px solid #333;\">';\n        html += '<td style=\"padding:6px 4px;\">' + logs[i].time + '</td>';\n        html += '<td style=\"padding:6px 4px;font-weight:bold;\">' + logs[i].type + '</td>';\n        html += '<td style=\"padding:6px 4px;\">' + logs[i].power + '</td>';\n        html += '<td style=\"padding:6px 4px;\">' + logs[i].volt + '</td>';\n        html += '<td style=\"padding:6px 4px;color:' + color + ';font-weight:bold;\">' + logs[i].severity + '</td>';\n        html += '</tr>';\n    }\n}\nhtml += '</table>';\n\nreturn { payload: html };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 540,
        "wires": [
            ["template_history_table"]
        ]
