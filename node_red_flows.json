    {
        "id": "fn_split_metrics",
        "type": "function",
        "z": "tab_smart_meter_ai",
        "name": "Extract Telemetry",
        "func": "var data = msg.payload;\n\n// Output 1: Active Power (kW)\nvar msgPower = { payload: Number(data.power_kw) };\n\n// Output 2: Line Voltage (V)\nvar msgVolt = { payload: Number(data.voltage) };\n\n// Output 3: Current (A)\nvar msgCurrent = { payload: Number(data.current) };\n\n// Output 4: Cumulative Energy (kWh)\nvar msgEnergy = { payload: data.energy_kwh + ' kWh' };\n\nreturn [msgPower, msgVolt, msgCurrent, msgEnergy];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 140,
        "wires": [
            ["gauge_power", "chart_power"],
            ["gauge_voltage"],
            ["gauge_current"],
            ["text_energy"]
        ]
    },
